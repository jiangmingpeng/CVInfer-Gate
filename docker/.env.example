# ============================================================
# docker compose 环境变量模板
# ------------------------------------------------------------
# 用法:
#     cp docker/.env.example docker/.env
#     # 然后编辑 docker/.env, 至少把两个 MySQL 口令填上(推荐一致)
# 说明: `docker compose` 会自动读取与本文件同目录的 .env。
#       config/ 里的 yaml 写的是 ${VAR}, 由这些变量注入(不改代码)。
#       本文件是模板, **不要**把真实口令提交回 git(.env 已被 .gitignore 忽略)。
# ============================================================

# ---- MySQL 口令(必填, 否则 mysql:8.0 因空口令初始化失败) ----
# MySQL root 口令(容器 mysql-db 用)
MYSQL_ROOT_PASSWORD=change-me
# C++ 网关连库口令 —— 与上面保持一致(网关用 root 连)
DB_PASSWORD=change-me

# ---- 主服务(50051)鉴权 token(可选; 留空 = 不鉴权) ----
# 非空时: gRPC 服务端 / web_gateway / grpc_client 三方必须完全一致
GRPC_AUTH_TOKEN=

# ---- 复核服务(50052)token(可选; 仅 Phase C 用) ----
# 非空时: cv-infer-gate 的 VLM_TOKEN 必须等于 vlm-review 的 VLM_AUTH_TOKEN
VLM_AUTH_TOKEN=

# ---- 告警 webhook 外发(可选; 仅 alert.push.enabled=true 用) ----
# 接收端跑在宿主机时用 host.docker.internal 回访
ALERT_PUSH_URL=
ALERT_TOKEN=

# ---- Phase C 复核服务上游 VLM(可选; 仅 --profile vlm 时用) ----
# 默认指向宿主机上的 OpenAI 兼容端点(如 vLLM/Ollama)
VLM_BASE_URL=http://host.docker.internal:8000/v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
VLM_API_KEY=EMPTY
