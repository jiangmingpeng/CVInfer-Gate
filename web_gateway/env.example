# ============================================================
# web_gateway 环境变量示例
# ------------------------------------------------------------
# 用法（三选一）：
#   1) PowerShell:  $env:GRPC_SERVER="127.0.0.1:50051"; python app.py
#   2) Linux/macOS: export GRPC_SERVER=127.0.0.1:50051; python app.py
#   3) 复制本文件为 .env（若已安装 python-dotenv 会自动加载）
# 说明：源码中不再硬编码任何 IP，以下全部可选，缺省即用默认值。
# ============================================================

# C++ gRPC 服务地址 host:port（不要再写死真实 IP）
#   本机映射： 127.0.0.1:50051
#   容器网络： cv-infer-gate:50051
GRPC_SERVER=127.0.0.1:50051

# 调用 gRPC 的超时 (毫秒)，需与 C++ 端 grpc.timeout_ms 保持一致
GRPC_TIMEOUT_MS=5000

# 收发消息上限 (MB)，需与 C++ 端 grpc.max_message_size_mb 保持一致（默认 4MB 会挡住大图）
GRPC_MAX_MSG_MB=16

# 主服务(50051)鉴权 token：非空则每次调用带 authorization: Bearer <token>
#   留空 => 不带 metadata（要求服务端也没开鉴权）；必须与 C++ 端 GRPC_AUTH_TOKEN 完全一致
GRPC_AUTH_TOKEN=

# Flask 监听地址与端口
WEB_HOST=0.0.0.0
WEB_PORT=8080

# ============================================================
# 结果回看（页面「③ 流水线结果」用；全部可选）
# ------------------------------------------------------------
# C++ 主程序把带框视频写成 output.avi（相对**启动目录**，一般从 build/ 启动）
#   => 默认就是 <仓库根>/build/output.avi，通常不用改
# 页面会自动做三件事：
#   1) 列出结果文件（视频/日志/降级 CSV）的大小与时间
#   2) 把 AVI(MJPEG) 按需转成 H.264 mp4 在线播放（浏览器放不了 MJPEG；转码结果缓存复用）
#   3) 从日志里抽出「占座/告警」事件列成时间线
# ============================================================

# 结果目录（output.avi / logs/ / db_fallback.csv 所在目录）
#   留空 = 自动用 <仓库根>/build（app.py 自己推算，通常不用改）
RESULT_DIR=

# 结果视频文件名（C++ 端 main.cpp 写死为 output.avi）
RESULT_VIDEO=output.avi

# 日志文件路径；留空 = 自动找 <RESULT_DIR>/logs/cvinfer.log
#   想让页面显示占座/告警事件，请把 config 里的 log.file 指到一个文件（例如 logs/cvinfer.log）
RESULT_LOG=

# ffmpeg 可执行文件（用来把 AVI 转成网页能播的 mp4）
FFMPEG_BIN=ffmpeg
